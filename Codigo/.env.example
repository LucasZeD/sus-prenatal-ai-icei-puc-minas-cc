# Copie para Codigo/.env e ajuste os valores.
# Nunca commite .env com segredos reais.
#
# Referência: Codigo/README.md | docker-compose.yml
NODE_ENV=development

# =============================================================================
# PostgreSQL (serviço `db`)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=sus_prenatal
POSTGRES_HOST_PORT=5432

# Prisma no host: mesmo POSTGRES_USER e POSTGRES_PASSWORD (evita erro P1000).
# O backend carrega backend/.env e depois Codigo/.env (este prevalece).
DATABASE_URL=postgresql://postgres:change_me_strong_password@127.0.0.1:5432/sus_prenatal

# =============================================================================
# Backend (Hono)
# =============================================================================
BACKEND_PUBLISH_PORT=3000
BACKEND_PORT=3000

# Rate limit HTTP (/api/v1 e rotas de IA)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20

# Concorrência de chamadas externas (429 quando saturado; sem fila em memória).
# Demo single-GPU: LLM=1 e CLINICAL_AI_PROXY=2; combine com OLLAMA_NUM_PARALLEL=1 no host.
SANITIZE_CONCURRENCY_LIMIT=4
LLM_CONCURRENCY_LIMIT=1
STT_CONCURRENCY_LIMIT=1
CLINICAL_AI_PROXY_CONCURRENCY_LIMIT=2

# =============================================================================
# Frontend (Docker + Vite)
# =============================================================================
# CORS — várias origens separadas por vírgula (ex.: http://192.168.0.10:5173).
FRONTEND_ORIGIN=http://localhost:5173

# Docker: "/" = nginx faz proxy para o backend (funciona no celular na LAN).
# Dev só Vite no PC: http://127.0.0.1:3000
VITE_API_BASE_URL=/
FRONTEND_PUBLISH_PORT=5173

# Build Docker do frontend (landing). Dev local: frontend/.env.example → frontend/.env
# VITE_LANDING_DEMO_VIDEO_URL=
# VITE_LANDING_SAMPLE_CARTILHA_PDF_URL=
VITE_LANDING_FEEDBACK_FORM_URL=

# =============================================================================
# MCP / clinical-ai (RAG + PII)
# =============================================================================
# Vazio = gateway noop no backend.
MCP_SERVER_URL=

# Compose: http://clinical_ai:4010 | Backend no host: http://127.0.0.1:4010
CLINICAL_AI_URL=http://clinical_ai:4010
CLINICAL_AI_PUBLISH_PORT=4010
CLINICAL_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

PII_NER_URL=http://pii_ner:4020
PII_NER_PUBLISH_PORT=4020
PII_NER_MODEL=OpenMed/OpenMed-PII-Portuguese-SnowflakeMed-Large-568M-v1
PII_NER_DEVICE=cpu
PII_NER_MIN_SCORE=0.75
PII_NER_MAX_CHARS=12000
PII_NER_TIMEOUT_S=4
PII_NER_REQUIRED=true
PII_NER_ALLOW_FALLBACK=true

# Raciocínio estendido Ollama (modelos compatíveis)
OLLAMA_THINK=false
MCP_CHAT_MAX_TOKENS=4096
MCP_CHAT_THINK_EXTRA_TOKENS=2048
MCP_CHAT_THINK_NUM_PREDICT_FLOOR=2048
MCP_CHAT_THINK_MAX_PREDICT=8192

# Opcional — nuvem (llm_provider=gemini ou fallback auto)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=120

RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_CORPUS_DIR=/app/corpus/CartilhasSUS
RAG_VECTOR_STORE_PATH=/app/data/rag_store.sqlite
RAG_DISABLE_VECTOR_STORE=
RAG_EXPORT_CHUNKS_JSONL=
RAG_RECENCY_WEIGHT=0.35
RAG_CHUNK_MAX_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_REQUIRE_EMBEDDING_INDEX=true
RAG_QUERY_EXPAND_ENABLED=true
RAG_QUERY_EXPAND_MAX_TOKENS=220
RAG_QUERY_EXPAND_MAX_OUT_CHARS=450

# =============================================================================
# Escriba — streaming (STT + LLM + RF04)
# =============================================================================
OLLAMA_HTTP_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b-medical-rag

STREAM_RAG_DEBOUNCE_MS=1500
STREAM_RAG_MIN_CHARS=14

# RF04: extração estruturada → form_patch (0/false desliga; omitido = ligado).
ESCRIBA_EXTRACT_ENABLED=1

# Demo GPU única: time_slice | exclusive_stt | livia_cloud (docs/STT_GPU_DEMO.md)
GPU_DEMO_MODE=time_slice

# =============================================================================
# Perfil Compose `ai` — STT (Whisper) + diarização
# =============================================================================
# Sem COMPOSE_PROFILES=ai, docker compose up não inclui stt nem diarization.
COMPOSE_PROFILES=ai

STT_PUBLISH_PORT=8000
WHISPER_HTTP_URL=http://stt:8000
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=float16

STT_CHUNK_MIN_MS=2500
STT_USE_PREPROCESS=true
STT_LANGUAGE=pt
STT_NOISE_REDUCE=false

# Anti-alucinação Whisper (silêncio / ruído ambiente) — stt-service
STT_MIN_RMS=0.004
STT_NO_SPEECH_THRESHOLD=0.6
STT_LOG_PROB_THRESHOLD=-1.0
STT_COMPRESSION_RATIO_THRESHOLD=2.4
STT_CONDITION_ON_PREVIOUS_TEXT=false

# Diarização (microsserviço diarization). Vazio = desligada; sistema sobe normalmente.
DIARIZATION_HTTP_URL=http://diarization:8001
DIARIZATION_DEVICE=cpu
DIARIZATION_GPU_GATE=0
DIARIZATION_BACKEND=auto
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_CONCURRENCY_LIMIT=1
DIARIZATION_FIRST_SPEAKER_ROLE=profissional
DIARIZATION_HF_OFFLINE=1
HF_TOKEN_FILE=./diarization/hf_token.txt

# =============================================================================
# Segurança e autenticação (RF14 / LGPD)
# =============================================================================
PACIENTE_IDS_PEPPER=change_me_long_random_pepper_for_hmac_only

JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_SEC=28800

# =============================================================================
# Seed e Dev Sandbox
# =============================================================================
SEED_PROFISSIONAL_EMAIL=admin@local.dev
SEED_PROFISSIONAL_PASSWORD=changeme_seed_password
SEED_PROFISSIONAL_NOME=Administrador local
# Gestantes demo (gráfico nutricional / apresentação): 1=ativo em DB local
SEED_DEMO_GESTANTE=1

# POST /api/v1/dev/profissionais — só com JWT de e-mail em DEV_ADMIN_EMAILS
DEV_ALLOW_PROFISSIONAL_CREATE=0
DEV_ALLOW_SANDBOX_DB_DELETE=1
DEV_ADMIN_EMAILS=admin@local.dev
